<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#F5F7FB">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Job Age Calculator"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your date of join"
        android:textSize="16sp"
        android:textColor="#64748B"
        android:layout_marginBottom="28dp" />

    <EditText
        android:id="@+id/dayEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Day (DD)"
        android:inputType="number"
        android:maxLength="2"
        android:singleLine="true"
        android:padding="14dp"
        android:backgroundTint="#2563EB" />

    <EditText
        android:id="@+id/monthEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Month (MM)"
        android:inputType="number"
        android:maxLength="2"
        android:singleLine="true"
        android:layout_marginTop="12dp"
        android:padding="14dp"
        android:backgroundTint="#2563EB" />

    <EditText
        android:id="@+id/yearEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Year (YYYY)"
        android:inputType="number"
        android:maxLength="4"
        android:singleLine="true"
        android:layout_marginTop="12dp"
        android:padding="14dp"
        android:backgroundTint="#2563EB" />

    <Button
        android:id="@+id/calculateBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calculate Age"
        android:textAllCaps="false"
        android:textSize="20sp"
        android:backgroundTint="@color/rootColour"
        android:layout_marginTop="28dp"
        android:padding="12dp" />

</LinearLayout>
